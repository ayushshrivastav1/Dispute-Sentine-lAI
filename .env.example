# ─────────────────────────────────────────────────────────
# DisputeSentinel AI — Environment Configuration Template
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ── Database ──────────────────────────────────────────────
# For local SQLite development:
DATABASE_URL=sqlite+aiosqlite:///./dispute_sentinel.db
# For PostgreSQL production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dispute_sentinel

# ── Razorpay API Credentials ─────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── LLM Provider Configuration ───────────────────────────
# Options: "groq", "openai", "anthropic"
LLM_PROVIDER=groq

# Groq API Key (for Llama 3.3 70B text generation)
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenAI API Key (for GPT-4o Vision OCR)
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Authentication & Security ─────────────────────────────
JWT_SECRET_KEY=your-256-bit-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ── Application Settings ─────────────────────────────────
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ── Policy Engine Thresholds ──────────────────────────────
# Win probability threshold for auto-contest (default: 0.75)
AUTO_CONTEST_THRESHOLD=0.75
# Win probability threshold for auto-accept (default: 0.40)
AUTO_ACCEPT_THRESHOLD=0.40
# Maximum dispute amount (in paise) for auto-contest (₹25,000 = 2500000)
MAX_AUTO_CONTEST_AMOUNT=2500000
